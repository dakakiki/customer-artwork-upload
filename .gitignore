# Node dependencies and package-manager caches
node_modules/
.npm/
.yarn/
.pnpm-store/

# WordPress build-tool caches and reports
.cache/
.eslintcache
coverage/

# Local environment and secrets
.env
.env.*
!.env.example

# Runtime and debug files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
debug.log

# IDE and editor settings
.idea/
.vscode/
*.code-workspace
*.swp
*.swo
*~

# Operating-system files
.DS_Store
Thumbs.db
Desktop.ini

# Composer dependencies (if Composer is added later)
vendor/

# Generated release packages
*.zip
release/
dist/

# Local WordPress test environments
.wp-env.json
.wp-env.override.json

# Keep compiled WordPress assets tracked and distributable.
!build/
!build/**
